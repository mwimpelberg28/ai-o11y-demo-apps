                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.9,
                    "drawStyle": "line",
                    "fillOpacity": 25,
                    "gradientMode": "opacity",
                    "hideFrom": {
                      "legend": false,
